{
  "version": "1.0",
  "comment": "Front Desk App Configuration Template - Copy to %APPDATA%/FrontDeskApp/config.json",
  
  "square": {
    "api_url": "https://connect.squareup.com/v2",
    "api_version": "2026-01-22",
    "timeout_seconds": 30,
    "retry_attempts": 3,
    "retry_delay_ms": 1000
  },
  
  "membership": {
    "mode": "segments_and_groups",
    "_mode_options": ["segments_only", "groups_only", "segments_and_groups"],
    "cache_refresh_interval_hours": 24,
    "auto_refresh_on_startup": true,
    "cache_stale_threshold_hours": 48,
    "membership_check_logic": "any_match",
    "_logic_options": ["any_match - customer is member if in ANY enabled segment or group"],
    
    "segments": [
      {
        "segment_id": "gv2:EXAMPLE_SEGMENT_ID",
        "display_name": "Annual Member",
        "enabled": true,
        "sort_order": 1
      }
    ],
    
    "groups": [
      {
        "group_id": "GRP_EXAMPLE_GROUP_ID",
        "display_name": "Pool Pass Holders",
        "enabled": true,
        "sort_order": 10
      }
    ]
  },
  
  "checkin": {
    "default_guest_count": 1,
    "max_guest_count": 10,
    "enable_day_pass": true,
    "offline_queue_enabled": true,
    "daily_backup_enabled": true,
    "backup_retention_days": 90
  },
  
  "search": {
    "fuzzy_matching_enabled": true,
    "min_search_length": 2,
    "max_results": 50,
    "search_timeout_seconds": 10
  },
  
  "ui": {
    "theme": "auto",
    "_theme_options": ["auto", "light", "dark"],
    "show_admin_button": true,
    "admin_password_hash": "",
    "_admin_password_note": "Leave empty to use default password 'PoolParty'. Change after first setup.",
    "session_timeout_minutes": 30,
    "confirmation_display_seconds": 3
  },
  
  "reports": {
    "default_export_path": "",
    "_export_path_note": "Leave empty to use Downloads folder",
    "include_member_details": true,
    "date_format": "yyyy-MM-dd",
    "time_format": "HH:mm:ss"
  },
  
  "cloud_sync": {
    "enabled": false,
    "mode": "multiple",
    "_mode_options": ["google_sheets", "onedrive", "multiple"],
    
    "sync_strategy": {
      "sync_on_checkin": true,
      "sync_interval_minutes": 5,
      "batch_size": 50,
      "retry_attempts": 3,
      "retry_delay_seconds": 30,
      "sync_historical_on_startup": false
    },
    
    "google_sheets": {
      "enabled": false,
      "spreadsheet_id": "",
      "sheet_name": "Check-ins",
      "credentials_file": "",
      "_credentials_note": "Path to google_oauth_credentials.json (stored in %APPDATA%/FrontDeskApp/)",
      
      "include_fields": {
        "timestamp": true,
        "customer_id": true,
        "customer_name": true,
        "first_name_only": false,
        "lot_number": true,
        "membership_types": true,
        "guest_count": true,
        "checkin_type": true,
        "location_id": true,
        "email": false,
        "phone": false,
        "full_address": false
      }
    },
    
    "onedrive_backup": {
      "enabled": false,
      "folder_path": "/FrontDeskApp/Backups",
      "file_format": "csv",
      "_file_format_options": ["csv", "json"],
      "strategy": "daily_files",
      "_strategy_options": ["daily_files", "single_file", "monthly_archives"],
      "credentials_file": ""
    },
    
    "fallback": {
      "on_sync_failure": "queue_locally",
      "_fallback_options": ["queue_locally", "log_only"],
      "max_queue_size": 10000,
      "queue_persistence": true
    }
  },
  
  "logging": {
    "level": "info",
    "_level_options": ["trace", "debug", "info", "warn", "error", "critical"],
    "max_file_size_mb": 10,
    "max_files": 5,
    "log_to_console": false
  },
  
  "database": {
    "path": "",
    "_path_note": "Leave empty to use %APPDATA%/FrontDeskApp/checkin.db",
    "backup_on_startup": true,
    "backup_path": "",
    "_backup_path_note": "Leave empty to use %APPDATA%/FrontDeskApp/backups",
    "vacuum_on_startup": false
  }
}
